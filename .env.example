# Copy to .env. Never commit .env or paste credentials into chat.
# Provider state is derived from required variables; no credentials = DEVELOPMENT mode.
KIS_APP_KEY=
KIS_APP_SECRET=
# Paper host is the default; do not replace with production host in V1.0.
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443

# KRX values are service-specific. Fill these only after the chosen service is approved.
KRX_BASE_URL=
KRX_ENDPOINT=
KRX_AUTH_KEY=
KRX_AUTH_PARAM=AUTH_KEY
KRX_DATE_PARAM=basDd
KRX_MARKET_PARAM=
KRX_MARKET_VALUE=

DART_API_KEY=
COLLECTIVE_ALPHA_DB=./data/collective_alpha.sqlite3
